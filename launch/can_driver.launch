<launch>
  <!-- =========================================================
       can_driver 启动文件
       启动顺序：加载参数 → 启动节点 → 加载控制器
       ========================================================= -->

  <!-- 是否加载 ros_control 控制器（默认 false：直通调试模式） -->
  <arg name="use_controllers" default="false"/>
  <arg name="start_controllers" default="joint_state_controller arm_controller wheel_controller"/>
  <arg name="can_driver_config" default="$(find can_driver)/config/can_driver.yaml"/>
  <arg name="can_driver_joints_overlay" default=""/>
  <arg name="robot_urdf" default=""/>
  <arg name="startup_position_sync_timeout_sec" default=""/>

  <!-- Optional lifecycle autostart for classified integration tests. -->
  <arg name="autostart_lifecycle" default="false"/>
  <arg name="lifecycle_init_device" default=""/>
  <arg name="lifecycle_init_loopback" default="false"/>
  <arg name="lifecycle_auto_enable" default="true"/>
  <arg name="lifecycle_auto_resume" default="true"/>
  <arg name="lifecycle_auto_recover" default="false"/>
  <arg name="lifecycle_startup_delay" default="1.0"/>
  <arg name="lifecycle_retry_period" default="1.0"/>
  <arg name="lifecycle_service_timeout" default="10.0"/>
  <arg name="lifecycle_max_attempts" default="3"/>

  <!-- ECB SDK 依赖该路径定位 logtool；对非 ECB 协议无副作用。 -->
  <env name="ACTUATOR_TOOL_PATH" value="$(find can_driver)/lib/innfos-cpp-sdk/tools/logtool/linux_x86_64"/>

  <!-- 1. 加载硬件参数（关节映射、控制频率） -->
  <rosparam file="$(arg can_driver_config)" command="load"/>
  <rosparam file="$(arg can_driver_joints_overlay)" command="load"
            if="$(eval can_driver_joints_overlay != '')"/>
  <param name="can_driver_node/startup_position_sync_timeout_sec"
         value="$(arg startup_position_sync_timeout_sec)"
         if="$(eval startup_position_sync_timeout_sec != '')"/>
  <param name="robot_description" textfile="$(arg robot_urdf)"
         if="$(eval robot_urdf != '')"/>

  <!-- 2. 加载控制器参数（仅在 use_controllers=true 时加载） -->
  <rosparam file="$(find can_driver)/config/ros_controllers.yaml" command="load"
            if="$(arg use_controllers)"/>

  <!-- 3. 启动 can_driver_node（包含 CanDriverHW + controller_manager 主循环） -->
  <node pkg="can_driver" type="can_driver_node" name="can_driver_node" output="screen"/>

  <node pkg="can_driver" type="lifecycle_compat_autostart.py" name="lifecycle_compat_autostart"
        output="screen" if="$(arg autostart_lifecycle)">
    <param name="driver_ns" value="/can_driver_node"/>
    <param name="init_device" value="$(arg lifecycle_init_device)"/>
    <param name="init_loopback" value="$(arg lifecycle_init_loopback)"/>
    <param name="auto_enable" value="$(arg lifecycle_auto_enable)"/>
    <param name="auto_resume" value="$(arg lifecycle_auto_resume)"/>
    <param name="auto_recover" value="$(arg lifecycle_auto_recover)"/>
    <param name="startup_delay" value="$(arg lifecycle_startup_delay)"/>
    <param name="retry_period" value="$(arg lifecycle_retry_period)"/>
    <param name="service_timeout" value="$(arg lifecycle_service_timeout)"/>
    <param name="max_attempts" value="$(arg lifecycle_max_attempts)"/>
  </node>

  <!-- 4. 加载并启动控制器（仅在 use_controllers=true 时启动） -->
  <node pkg="controller_manager" type="spawner" name="controller_spawner"
        args="$(arg start_controllers)" if="$(arg use_controllers)"/>

</launch>
